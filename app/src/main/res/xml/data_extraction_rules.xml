<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the same database and settings go to cloud backup and to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="settings.xml" />
    </device-transfer>
</data-extraction-rules>
