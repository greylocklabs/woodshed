// Receives problem reports from the app and files them as GitHub issues through the woodshed-reports GitHub App.
// The app's private key is a secret: `npx wrangler secret put GITHUB_PRIVATE_KEY` (PKCS#8 PEM).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "woodshed-reports",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "observability": { "enabled": true },
  "vars": {
    "GITHUB_REPO": "lararosekelley/woodshed",
    "GITHUB_APP_ID": "5320150",
    "GITHUB_INSTALLATION_ID": "171473671"
  },
  // Five reports a minute from one address is plenty for a person and little use to a spammer.
  "ratelimits": [{ "name": "REPORT_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }]
}
